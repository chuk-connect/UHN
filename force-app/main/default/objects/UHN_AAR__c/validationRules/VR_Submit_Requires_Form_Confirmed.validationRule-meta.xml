<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submit_Requires_Form_Confirmed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Submitted&quot;),
  NOT(Form_Confirmed_Accurate__c)
)</errorConditionFormula>
    <errorMessage
  >Please confirm the form is accurate before submitting.</errorMessage>
</ValidationRule>
