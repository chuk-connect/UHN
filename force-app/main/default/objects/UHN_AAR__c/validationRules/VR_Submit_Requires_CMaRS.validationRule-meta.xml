<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submit_Requires_CMaRS</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Submitted&quot;),
  NOT(CMaRS_Updated__c)
)</errorConditionFormula>
    <errorMessage
  >Your CMaRS relationship disclosure must be updated before submission.</errorMessage>
</ValidationRule>
