<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Block_Submit_No_MyLearning</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, 'Submitted'),
  NOT(Mandatory_Training_Complete__c)
)</errorConditionFormula>
    <errorMessage
  >MyLearning training must be completed before you can submit your AAR.</errorMessage>
    <errorDisplayField>Mandatory_Training_Complete__c</errorDisplayField>
</ValidationRule>
