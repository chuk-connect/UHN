<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submit_Requires_MyLearning</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Submitted&quot;),
  NOT(Mandatory_Training_Complete__c)
)</errorConditionFormula>
    <errorMessage
  >MyLearning training must be completed before you can submit your AAR.</errorMessage>
</ValidationRule>
