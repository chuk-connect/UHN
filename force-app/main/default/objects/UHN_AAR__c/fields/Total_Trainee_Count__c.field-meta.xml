<?xml version="1.0" encoding="UTF-8"?>
<CustomField xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Total_Trainee_Count__c</fullName>
    <description>Sum of all trainee type counts (Graduate Students + Postdocs + Research Assistants + Other). System-managed formula — do not edit.</description>
    <externalId>false</externalId>
    <formula>BLANKVALUE(Graduate_Student_Count__c, 0) +
BLANKVALUE(Postdoc_Count__c, 0) +
BLANKVALUE(Research_Assistant_Count__c, 0) +
BLANKVALUE(Other_Trainee_Count__c, 0)</formula>
    <formulaTreatBlanksAs>BlankAsZero</formulaTreatBlanksAs>
    <label>Total Trainee Count</label>
    <precision>18</precision>
    <required>false</required>
    <scale>0</scale>
    <trackHistory>false</trackHistory>
    <trackTrending>false</trackTrending>
    <type>Number</type>
    <unique>false</unique>
</CustomField>
