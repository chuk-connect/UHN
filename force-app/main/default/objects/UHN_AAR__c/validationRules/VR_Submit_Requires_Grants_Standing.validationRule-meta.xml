<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Submit_Requires_Grants_Standing</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Submitted&quot;),
  NOT(Grants_Good_Standing__c)
)</errorConditionFormula>
    <errorMessage
  >All grant accounts must be in good standing before submission.</errorMessage>
</ValidationRule>
