<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <description>Configuration for the Verification Framework. Each record binds a verifiable child object to its parent lookup field. Lets the verification card render against any parent record without code changes.</description>
    <label>Verification Binding</label>
    <pluralLabel>Verification Bindings</pluralLabel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Child_Object__c</fullName>
        <description>API name of the verifiable child object, e.g. UHN_Publication_Author__c.</description>
        <label>Child Object</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>Parent_Lookup_Field__c</fullName>
        <description>API name of the lookup field on the child object that points to the parent record (e.g. AAR__c).</description>
        <label>Parent Lookup Field</label>
        <length>100</length>
        <required>true</required>
        <type>Text</type>
    </fields>
</CustomObject>
