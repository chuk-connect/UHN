<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>VR_Attestation_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, &quot;Submitted&quot;),
  ISBLANK(Attested_By__c)
)</errorConditionFormula>
    <errorMessage>Attestation required before submission. Please complete attestation screen.</errorMessage>
</ValidationRule>
