<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <fields>
        <fullName>External_Id__c</fullName>
        <description>Stable identifier from the upstream source system. Used by the reconciliation service to match incoming source updates to existing records.</description>
        <externalId>true</externalId>
        <label>External Id</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>true</unique>
    </fields>
    <fields>
        <fullName>Override_Payload__c</fullName>
        <description>JSON delta of PI corrections. New overrideable fields require zero schema migration — just update the field set the verification card reads.</description>
        <label>Override Payload</label>
        <length>131072</length>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Source_Hash__c</fullName>
        <description>SHA-256 of the last source payload processed. Used by the reconciliation service to detect drift without diffing JSON.</description>
        <label>Source Hash</label>
        <length>64</length>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Source_Payload__c</fullName>
        <description>JSON snapshot of the last source projection processed. Merged with Override_Payload__c at display time.</description>
        <label>Source Payload</label>
        <length>131072</length>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Verification_Status__c</fullName>
        <description>Current state in the verification state machine. Managed by VerificationReconciliationService — do not update directly.</description>
        <label>Verification Status</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Proposed</fullName>
                    <default>true</default>
                    <label>Proposed</label>
                </value>
                <value>
                    <fullName>Verified</fullName>
                    <default>false</default>
                    <label>Verified</label>
                </value>
                <value>
                    <fullName>Manual</fullName>
                    <default>false</default>
                    <label>Manual</label>
                </value>
                <value>
                    <fullName>Superseded</fullName>
                    <default>false</default>
                    <label>Superseded</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>Verified_At__c</fullName>
        <description>Timestamp of the most recent PI attestation.</description>
        <label>Verified At</label>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Verified_By__c</fullName>
        <description>User who most recently attested to this record.</description>
        <label>Verified By</label>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Verified Scholarly Outputs</relationshipLabel>
        <relationshipName>Verified_Scholarly_Outputs</relationshipName>
        <type>Lookup</type>
    </fields>
    <fieldSets>
        <fullName>Scholarly_Output_Verification</fullName>
        <description>Field set used by the c-verification-card LWC on the UHN_AAR__c page. Lists the verification metadata fields. Add source-system content fields (Title, DOI, Journal, etc.) here once they exist on the object.</description>
        <displayedFields>
            <field>Verification_Status__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>External_Id__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <displayedFields>
            <field>Verified_At__c</field>
            <isFieldManaged>false</isFieldManaged>
            <isRequired>false</isRequired>
        </displayedFields>
        <label>Scholarly Output Verification</label>
    </fieldSets>
</CustomObject>
