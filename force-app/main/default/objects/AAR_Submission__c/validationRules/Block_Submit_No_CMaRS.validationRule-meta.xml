<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Block_Submit_No_CMaRS</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, 'Submitted'),
  NOT(CMaRS_Updated__c)
)</errorConditionFormula>
    <errorMessage
  >Your CMaRS relationship disclosure must be updated before submission.</errorMessage>
    <errorDisplayField>CMaRS_Updated__c</errorDisplayField>
</ValidationRule>
