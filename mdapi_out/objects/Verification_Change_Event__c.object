<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <deploymentStatus>Deployed</deploymentStatus>
    <description>Append-only audit log for the Business Hub Verification Framework. Every state transition (Proposed Created, Verified, Override Applied, Source Drift, etc.) writes one row here. Feeds the bulk export (EXP-03) and year-two trust dashboards. Never updated or deleted in normal operation.</description>
    <enableActivities>false</enableActivities>
    <enableBulkApi>true</enableBulkApi>
    <enableFeeds>false</enableFeeds>
    <enableHistory>false</enableHistory>
    <enableReports>true</enableReports>
    <enableSearch>true</enableSearch>
    <enableSharing>true</enableSharing>
    <enableStreamingApi>true</enableStreamingApi>
    <label>Verification Change Event</label>
    <nameField>
        <displayFormat>VCE-{00000000}</displayFormat>
        <label>Event Number</label>
        <type>AutoNumber</type>
    </nameField>
    <pluralLabel>Verification Change Events</pluralLabel>
    <searchLayouts></searchLayouts>
    <sharingModel>ReadWrite</sharingModel>
    <visibility>Public</visibility>
    <fields>
        <fullName>Actor_User_Id__c</fullName>
        <description>Who performed the action. UserInfo.getUserId() at the time of the event.</description>
        <label>Actor User Id</label>
        <referenceTo>User</referenceTo>
        <relationshipLabel>Verification Events</relationshipLabel>
        <relationshipName>Verification_Events</relationshipName>
        <type>Lookup</type>
    </fields>
    <fields>
        <fullName>After_Payload__c</fullName>
        <description>JSON snapshot of the source payload (or override delta) after the transition.</description>
        <label>After Payload</label>
        <length>131072</length>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Before_Payload__c</fullName>
        <description>JSON snapshot of the source payload before the transition (where applicable).</description>
        <label>Before Payload</label>
        <length>131072</length>
        <type>LongTextArea</type>
        <visibleLines>5</visibleLines>
    </fields>
    <fields>
        <fullName>Event_Type__c</fullName>
        <description>The transition that occurred. Constrained to the values the service emits.</description>
        <label>Event Type</label>
        <required>true</required>
        <type>Picklist</type>
        <valueSet>
            <restricted>true</restricted>
            <valueSetDefinition>
                <sorted>false</sorted>
                <value>
                    <fullName>Proposed Created</fullName>
                    <default>false</default>
                    <label>Proposed Created</label>
                </value>
                <value>
                    <fullName>Proposed Updated</fullName>
                    <default>false</default>
                    <label>Proposed Updated</label>
                </value>
                <value>
                    <fullName>Verified</fullName>
                    <default>false</default>
                    <label>Verified</label>
                </value>
                <value>
                    <fullName>Override Applied</fullName>
                    <default>false</default>
                    <label>Override Applied</label>
                </value>
                <value>
                    <fullName>Source Changed Under Verified</fullName>
                    <default>false</default>
                    <label>Source Changed Under Verified</label>
                </value>
                <value>
                    <fullName>Manual Created</fullName>
                    <default>false</default>
                    <label>Manual Created</label>
                </value>
                <value>
                    <fullName>Manual Superseded</fullName>
                    <default>false</default>
                    <label>Manual Superseded</label>
                </value>
            </valueSetDefinition>
        </valueSet>
    </fields>
    <fields>
        <fullName>External_Id__c</fullName>
        <description>Stable identifier from the source system. Useful for debugging and for correlating events when records are deleted/recreated.</description>
        <externalId>true</externalId>
        <label>External Id</label>
        <length>255</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
    <fields>
        <fullName>Occurred_At__c</fullName>
        <description>System.now() at the moment of the transition. Indexed for time-windowed queries.</description>
        <label>Occurred At</label>
        <required>true</required>
        <type>DateTime</type>
    </fields>
    <fields>
        <fullName>Subject_Record_Id__c</fullName>
        <description>Id of the verifiable record this event refers to. Polymorphic by design — we don&apos;t lock the event log to a single object type so the same log can serve every Business Hub module.</description>
        <externalId>true</externalId>
        <label>Subject Record Id</label>
        <length>18</length>
        <required>false</required>
        <type>Text</type>
        <unique>false</unique>
    </fields>
</CustomObject>
