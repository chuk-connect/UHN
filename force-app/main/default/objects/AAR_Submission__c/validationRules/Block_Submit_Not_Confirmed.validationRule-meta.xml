<?xml version="1.0" encoding="UTF-8" ?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Block_Submit_Not_Confirmed</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
  ISPICKVAL(Status__c, 'Submitted'),
  NOT(Form_Confirmed_Accurate__c)
)</errorConditionFormula>
    <errorMessage
  >Please confirm the form is accurate before submitting.</errorMessage>
    <errorDisplayField>Form_Confirmed_Accurate__c</errorDisplayField>
</ValidationRule>
